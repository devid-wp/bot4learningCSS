# ============================================================
#  Скопируй этот файл в .env и заполни. .env НЕ коммитится.
#  cp .env.example .env
# ============================================================

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# --- OpenRouter ---
# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Любая модель OpenRouter. Примеры:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
# Можно и бесплатные варианты с суффиксом :free
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=css-tutor-bot

# --- Database ---
DB_PATH=data/bot.db

# --- Courses (YAML) ---
COURSES_DIR=courses

# --- Logging ---
LOG_LEVEL=INFO

# --- AI client ---
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# --- Reminders ---
DEFAULT_REMINDER_INTERVAL_MINUTES=60
REMINDER_MIN_INTERVAL_MINUTES=30
